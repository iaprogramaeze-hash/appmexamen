# Backend EPET36 — ejemplo de variables de entorno.
# Copiar las lineas a un archivo .env local para desarrollo.
# NOTA: el nombre es env.example (sin punto inicial) porque el runtime bloquea
# la creacion de rutas .env*; el .env real NUNCA se commitea (analisis.txt 0:
# "Variables de entorno: nunca en el repo; se definen en el panel de Vercel, por entorno").

# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Produccion (Vercel): conexion DIRECTA a Neon, host SIN sufijo "-pooler"
# (PgBouncer transaction no soporta DDL). Desarrollo: cualquier PostgreSQL.
# Si se omite, la app arranca sin base y /healthz responde db=unavailable.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require

# Migraciones (opcional): URL explicita para alembic. Si no existe, env.py usa
# DATABASE_URL omitiendo el sufijo "-pooler" automaticamente (host directo,
# analisis.txt 0 / PD-06) y lo informa en el log.
# MIGRATE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-DIRECTO/DATABASE?ssl=require

# Seguridad JWT (analisis.txt 2.1): keyset asimétrico ES256. Obligatorio en
# produccion (el Settings lo rechaza si falta). Generar el par con:
#   python -c "from app.core.security import generate_keypair; p, u = generate_keypair(); print(p); print(u)"
# Pegar cada PEM como una sola linea, con \n literal donde van los saltos de linea.
# En development/test, si se omiten, la app genera un keyset efímero al arrancar.
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# JWT_KID=epet36-key-1

# Ajustes JWT opcionales (defaults = valores de analisis.txt 2.1/2.2).
# ACCESS_TOKEN_EXPIRE_MINUTES=15   # 15 min; maximo permitido 30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT_ISSUER=backend-epet-n36
# JWT_AUDIENCE=epet36-api

# Origen exacto de la landing (lista JSON). NFR-023 espera ese origen;
# [] deja el CORS deshabilitado. Nunca "*" en produccion (analisis.txt 0).
CORS_ORIGINS=[]

# SMTP de la cola de email (RB-25 / NFR-033). Obligatorio para que el
# restablecimiento de clave entregue el token por correo: sin SMTP_HOST los
# envios quedan 'pendientes' en ntf_envio (dev/test) y la app arranca igual.
# OJO con el puerto: STARTTLS=true usa SMTP (default 587); si STARTTLS=false
# se usa SMTP_SSL y el puerto debe ser 465 (no 587).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com    # si se omite, se usa SMTP_USER
# SMTP_STARTTLS=true
